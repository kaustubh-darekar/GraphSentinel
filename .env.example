OPENAI_API_KEY=            # only needed for GS_MODE=live
OPENAI_MODEL=              # fill in the chat model you want to use
OPENAI_EMBED_MODEL=        # paraphrase detection in live precise sessions (e.g. text-embedding-3-small)
OPENAI_REASONING_EFFORT=   # optional; set to none if your model rejects tools with reasoning
GS_MODE=scripted           # scripted (no key, deterministic) | live (real LLM)
GS_STORE_PATH=./stores/graphsentinel
# Trusted destinations; wildcards allowed: *@acme.test (whole domain), #internal* (channel prefix)
GS_TRUSTED_DESTINATIONS=*@acme.test,#internal*
GS_LINEAGE_MODE=strict     # strict (anything in context counts) | precise (content match only)
